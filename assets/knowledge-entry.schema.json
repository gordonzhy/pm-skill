{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private knowledge entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "scope",
    "kind",
    "status",
    "basis",
    "keywords",
    "aliases",
    "sources",
    "replaces",
    "related",
    "recorded_at",
    "verified_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "kind": {
      "enum": [
        "decision",
        "procedure",
        "fact",
        "lesson",
        "proposal"
      ]
    },
    "status": {
      "enum": [
        "current",
        "unverified",
        "superseded",
        "retired"
      ]
    },
    "basis": {
      "enum": [
        "user-decision",
        "engineering-evidence",
        "unverified"
      ]
    },
    "keywords": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0
    },
    "aliases": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1
    },
    "replaces": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0
    },
    "related": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0
    },
    "recorded_at": {
      "type": "string",
      "format": "date"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "basis": {
            "const": "user-decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "const": "unverified"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "unverified",
              "superseded",
              "retired"
            ]
          },
          "verified_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "const": "engineering-evidence"
          }
        }
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "else": {
        "properties": {
          "verified_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
